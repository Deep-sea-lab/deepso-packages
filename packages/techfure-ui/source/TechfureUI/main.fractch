sprite "TechfureUI" at 0,0 size 100 hidden layer 1;
costume "Desktop" file "assets/desktop.svg" center 240,180 current;
costume "Welcome" file "assets/welcome.svg" center 240,180;
costume "Files" file "assets/files.svg" center 240,180;
costume "Settings" file "assets/settings.svg" center 240,180;
costume "About" file "assets/about.svg" center 240,180;

var page = 0;
var running = 0;

def @draw() {
  if vars["page"] == 0 {
    costume "Desktop";
  } else if vars["page"] == 1 {
    costume "Welcome";
  } else if vars["page"] == 2 {
    costume "Files";
  } else if vars["page"] == 3 {
    costume "Settings";
  } else {
    costume "About";
  }
}

when broadcast "DSO_PROCESS_WAKE" {
  if vars["_DSO_START_REQUEST"] == "techfure-ui" {
    vars["page"] = 0;
    vars["running"] = 1;
    @draw();
    show;
    vars["_DSO_START_ACK"] = "techfure-ui";

    forever {
      if vars["_DSO_STOP_REQUEST"] == "techfure-ui" {
        vars["running"] = 0;
      }
      if vars["running"] == 0 {
        hide;
        vars["_DSO_APP_EXITED"] = "techfure-ui";
        break;
      }
      wait 0.05;
    }
  }
}

when key "right arrow" {
  if vars["running"] == 1 {
    vars["page"] = (vars["page"] + 1) % 5;
    @draw();
  }
}

when key "left arrow" {
  if vars["running"] == 1 {
    vars["page"] = (vars["page"] + 4) % 5;
    @draw();
  }
}

when key "enter" {
  if vars["running"] == 1 && vars["page"] == 0 {
    vars["page"] = 1;
    @draw();
  }
}

when key "escape" {
  if vars["running"] == 1 {
    if vars["page"] == 0 {
      vars["running"] = 0;
    } else {
      vars["page"] = 0;
      @draw();
    }
  }
}

when clicked {
  if vars["running"] == 1 {
    vars["page"] = (vars["page"] + 1) % 5;
    @draw();
  }
}
